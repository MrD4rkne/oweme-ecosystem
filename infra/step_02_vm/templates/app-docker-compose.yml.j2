name: {{ item.name }}

networks:
  web:
    external: true
  app-backend:
    external: true
  internal:
    internal: true

services:
  {{ item.name }}:
    image: ghcr.io/{{ github_org_repo | lower }}/{{ item.image_name }}:{{ image_tag }}
    restart: unless-stopped
    env_file: .env
{% if item.depends_on | length > 0 %}
    depends_on:
{% for dep in item.depends_on %}
      - {{ dep }}
{% endfor %}
{% endif %}
    networks:
      - web
      - app-backend
      - internal
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 512M
{% if item.healthcheck_path %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ item.container_port }}{{ item.healthcheck_path }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s
{% endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=web"
      - "traefik.http.routers.{{ item.name }}.rule=Host(`{{ item.hostname }}`)"
      - "traefik.http.routers.{{ item.name }}.entrypoints=websecure"
      - "traefik.http.routers.{{ item.name }}.tls.certresolver=letsencrypt"
      - "traefik.http.services.{{ item.name }}.loadbalancer.server.port={{ item.container_port }}"

  {{ item.name }}-db:
    image: postgres:16
    restart: unless-stopped
    env_file: .env
    volumes:
      - {{ item.name }}-db-data:/var/lib/postgresql/data
    networks:
      - internal
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: 512M
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ item.db_user }} -d {{ item.db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  {{ item.name }}-db-data:
