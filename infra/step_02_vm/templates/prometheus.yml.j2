global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "traefik"
    static_configs:
      - targets: ["traefik:8082"]

  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

# Add a job per app once they expose /metrics (e.g. via prometheus-net for .NET):
