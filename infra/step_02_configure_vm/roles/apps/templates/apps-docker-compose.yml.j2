services:
  api-db:
    image: postgres:16-alpine
    restart: unless-stopped
    env_file: api.env
    volumes:
      - api-db-data:/var/lib/postgresql/data
    networks: [app-backend]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U api"]
      interval: 5s
      timeout: 5s
      retries: 10

  api:
    image: ghcr.io/mrd4rkne/oweme-ecosystem/oweme-api:${API_IMAGE_TAG:-latest}
    restart: unless-stopped
    env_file: api.env
    depends_on:
      api-db:
        condition: service_healthy
      keycloak:
        condition: service_healthy
    networks: [web, app-backend, monitoring]
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.api.rule=Host(`{{ api_hostname }}`)"
      - "traefik.http.routers.api.tls.certresolver=letsencrypt"

      - "traefik.http.routers.api-internal.rule=Host(`{{ api_hostname }}`) && (Path(`/healthz`) || Path(`/live`) || Path(`/ready`))"
      - "traefik.http.routers.api-internal.priority=100"
      - "traefik.http.routers.api-internal.service=noop@internal"
      - "traefik.http.routers.api-internal.tls.certresolver=letsencrypt"
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:8080/healthz" ]
      interval: 10s
      timeout: 5s
      retries: 5

  keycloak-db:
    image: postgres:16-alpine
    restart: unless-stopped
    env_file: keycloak.env
    volumes:
      - keycloak-db-data:/var/lib/postgresql/data
    networks: [app-backend]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U keycloak"]
      interval: 5s
      timeout: 5s
      retries: 10

  keycloak:
    image: quay.io/keycloak/keycloak:{{ keycloak_version }}
    restart: unless-stopped
    command: start --health-enabled=true --http-enabled=true --proxy-headers=xforwarded --hostname-strict=false
    env_file: keycloak.env
    depends_on:
      keycloak-db:
        condition: service_healthy
    networks: [web, app-backend, monitoring]
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.keycloak.rule=Host(`{{ idp_hostname }}`)"
      - "traefik.http.routers.keycloak.tls.certresolver=letsencrypt"
      - "traefik.http.services.keycloak.loadbalancer.server.port=8080"
    healthcheck:
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/localhost/9000 && printf 'GET /health/ready HTTP/1.1\r\nhost: localhost\r\nConnection: close\r\n\r\n' >&3 && grep -q '200 OK' <&3"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

networks:
  web:
    external: true
  app-backend:
    external: true
  monitoring:
    external: true

volumes:
  api-db-data:
  keycloak-db-data:
