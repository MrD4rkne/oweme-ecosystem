{% set db_name = 'keycloak' %}
{% set db_user = 'keycloak' %}
{% set db_pass = vault_keycloak_db_password | replace('$', '$$') %}

POSTGRES_USER={{ db_user }}
POSTGRES_DB={{ db_name }}
POSTGRES_PASSWORD={{ db_pass }}

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/{{ db_name }}
KC_DB_USERNAME={{ db_user }}
KC_DB_PASSWORD={{ db_pass }}
KC_HOSTNAME={{ idp_hostname }}
KEYCLOAK_ADMIN={{ vault_keycloak_admin_user }}
KEYCLOAK_ADMIN_PASSWORD={{ vault_keycloak_admin_password | replace('$', '$$') }}
