{% set db_name = 'api' %}
{% set db_user = 'api' %}
{% set db_pass = vault_api_db_password | replace('$', '$$') %}

# PostgreSQL Init Variables (Used by the DB container)
POSTGRES_USER={{ db_user }}
POSTGRES_DB={{ db_name }}
POSTGRES_PASSWORD={{ db_pass }}

# Application Variables (Used by the .NET container)
API_IMAGE_TAG=latest
ASPNETCORE_ENVIRONMENT={{ aspnetcore_environment | default('Production') }}
Database__ConnectionString=Host=api-db;Database={{ db_name }};Username={{ db_user }};Password={{ db_pass }}
Database__RunMigrations=true

# Identity Variables
IdentityServer__Authority={{ identity_authority_url }}
IdentityServer__MetadataAddress=http://auth:8080/.well-known/openid-configuration
IdentityServer__RequireHttpsMetadata=false
